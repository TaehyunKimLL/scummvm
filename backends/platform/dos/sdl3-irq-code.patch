From 09c194ca773af0dfd9627b12f5e7e63fbbd6249e Mon Sep 17 00:00:00 2001
From: thkim <dice.thkim@gmail.com>
Date: Thu, 1 Oct 2026 00:48:54 +0000
Subject: [PATCH] dos: Lock interrupt handler code as one section range per
 file

GCC emits functions in any order, so the _End marker functions placed
after each handler were not reliably after it: in the static build every
Sound Blaster marker came before its function, the lock sizes were
negative and nothing was locked. The handler also called libc memcpy.
Put handler code in .text.dosirq_b between labels in .text.dosirq_a/c,
copy inline, use inlined port I/O, and export DOS_IRQCodeLocked so an
application can require this.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01429qJytiMpcCADjppM2jV4
---
 src/audio/dos/SDL_dosaudio_sb.c | 49 ++++++++++++++++++-------------
 src/core/dos/SDL_dos.c          |  2 ++
 src/core/dos/SDL_dos.h          | 51 +++++++++++++++++++++++++++++++--
 src/video/dos/SDL_dosevents.c   | 10 ++++---
 4 files changed, 86 insertions(+), 26 deletions(-)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 2958c56..ee19448 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -30,6 +30,9 @@
 // Useful for testing in DOSBox which always emulates an SB16 (DSP 4.x).
 #define FORCE_SB_8BIT 0
 
+// The interrupt handler's code (DOS_IRQ_CODE below), locked as one range.
+DOS_IRQ_CODE_RANGE(sb);
+
 static int soundblaster_base_port = -1;
 static int soundblaster_irq = -1;
 static int soundblaster_dma_channel = -1;
@@ -100,50 +103,59 @@ static int isr_dma_channel = 0;
 static bool isr_is_16bit = false;
 static Uint8 isr_silence_value = 0;
 
+// memcpy() and memset() for the handler, inline: libc's are not locked.
+SDL_FORCE_INLINE void ISR_Copy(Uint8 *dst, const Uint8 *src, int len)
+{
+    __asm__ __volatile__("cld; rep movsb" : "+D"(dst), "+S"(src), "+c"(len) : : "memory");
+}
+
+SDL_FORCE_INLINE void ISR_Fill(Uint8 *dst, Uint8 value, int len)
+{
+    __asm__ __volatile__("cld; rep stosb" : "+D"(dst), "+c"(len) : "a"(value) : "memory");
+}
+
 // Copy `len` bytes from the ring buffer at position `pos` into `dst`,
 // handling the power-of-2 wrap. All pointers are memory-locked.
-static void RingCopyOut(Uint8 *dst, int pos, int len)
+static DOS_IRQ_CODE void RingCopyOut(Uint8 *dst, int pos, int len)
 {
     const int mask = isr_ring_mask;
     const int start = pos & mask;
     const int first = (start + len <= isr_ring_size) ? len : (isr_ring_size - start);
-    SDL_memcpy(dst, isr_ring_buffer + start, first);
+    ISR_Copy(dst, isr_ring_buffer + start, first);
     if (first < len) {
-        SDL_memcpy(dst + first, isr_ring_buffer, len - first);
+        ISR_Copy(dst + first, isr_ring_buffer, len - first);
     }
 }
-static void RingCopyOut_End(void) {}
 
 // Determine which DMA half-buffer the hardware is NOT currently playing
 // (i.e. the one we should fill). Uses ISR-cached statics so we don't
 // chase any heap pointers.
-static Uint8 *ISR_GetDMAHalf(void)
+static DOS_IRQ_CODE Uint8 *ISR_GetDMAHalf(void)
 {
     int count;
     if (isr_is_16bit) {
-        outportb(0xD8, 0x00);
-        count = (int)inportb(0xC0 + (isr_dma_channel - 4) * 4 + 2);
-        count += (int)inportb(0xC0 + (isr_dma_channel - 4) * 4 + 2) << 8;
+        DOS_OutPort8(0xD8, 0x00);
+        count = (int)DOS_InPort8(0xC0 + (isr_dma_channel - 4) * 4 + 2);
+        count += (int)DOS_InPort8(0xC0 + (isr_dma_channel - 4) * 4 + 2) << 8;
         return isr_dma_buffer + (count < (isr_dma_halfdma / 2) ? 0 : isr_dma_halfdma);
     } else {
-        outportb(0x0C, 0x00);
-        count = (int)inportb(isr_dma_channel * 2 + 1);
-        count += (int)inportb(isr_dma_channel * 2 + 1) << 8;
+        DOS_OutPort8(0x0C, 0x00);
+        count = (int)DOS_InPort8(isr_dma_channel * 2 + 1);
+        count += (int)DOS_InPort8(isr_dma_channel * 2 + 1) << 8;
         return isr_dma_buffer + (count < isr_dma_halfdma ? 0 : isr_dma_halfdma);
     }
 }
-static void ISR_GetDMAHalf_End(void) {}
 
 // The IRQ handler. Copies one chunk from the ring buffer into the DMA
 // half-buffer that the hardware isn't currently playing. If the ring is
 // empty it fills with silence (no stutter, just a brief gap).
 //
 // This function touches ONLY memory-locked data and does ONLY port I/O and
-// memcpy. No DPMI, no malloc, no mutex, no FPU.
-static void SoundBlasterIRQHandler(void)
+// copies. No DPMI, no malloc, no mutex, no FPU.
+static DOS_IRQ_CODE void SoundBlasterIRQHandler(void)
 {
     // Acknowledge hardware first.
-    inportb(isr_irq_ack_port);
+    DOS_InPort8(isr_irq_ack_port);
     DOS_EndOfInterrupt(soundblaster_irq);
 
     Uint8 *dma_dst = ISR_GetDMAHalf();
@@ -156,10 +168,9 @@ static void SoundBlasterIRQHandler(void)
         isr_ring_read += isr_chunk_size;
     } else {
         // Ring underrun: fill with silence so we don't replay stale audio.
-        SDL_memset(dma_dst, isr_silence_value, isr_chunk_size);
+        ISR_Fill(dma_dst, isr_silence_value, isr_chunk_size);
     }
 }
-static void SoundBlasterIRQHandler_End(void) {}
 
 // Wait until the ring buffer has room for one more chunk.
 // The audio thread keeps yielding so the game's main thread can run while
@@ -337,9 +348,7 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
     isr_silence_value = soundblaster_silence_value;
 
     // Lock all ISR code and data to prevent page faults during interrupts.
-    DOS_LockCode(SoundBlasterIRQHandler, SoundBlasterIRQHandler_End);
-    DOS_LockCode(RingCopyOut, RingCopyOut_End);
-    DOS_LockCode(ISR_GetDMAHalf, ISR_GetDMAHalf_End);
+    DOS_LockIRQCode(sb);
     DOS_LockData(*hidden->ring_buffer, hidden->ring_size);
     DOS_LockVariable(isr_ring_read);
     DOS_LockVariable(isr_ring_write);
diff --git a/src/core/dos/SDL_dos.c b/src/core/dos/SDL_dos.c
index 0ba0773..ed133e5 100644
--- a/src/core/dos/SDL_dos.c
+++ b/src/core/dos/SDL_dos.c
@@ -24,6 +24,8 @@
 
 #include "SDL_dos.h"
 
+const int DOS_IRQCodeLocked = 1;
+
 void *DOS_AllocateConventionalMemory(const int len, _go32_dpmi_seginfo *seginfo)
 {
     seginfo->size = (len + 15) / 16; // this is in "paragraphs"
diff --git a/src/core/dos/SDL_dos.h b/src/core/dos/SDL_dos.h
index 11dc58d..05b30dc 100644
--- a/src/core/dos/SDL_dos.h
+++ b/src/core/dos/SDL_dos.h
@@ -53,6 +53,53 @@
 #define DOS_LockCode(start, end) \
     _go32_dpmi_lock_code((void *)(start), (char *)(end) - (char *)(start))
 
+// Interrupt handler code, locked as one range per source file.
+//
+// A page fault is fatal in a hardware interrupt that came in real mode, so
+// whatever runs there must be locked. Marker functions placed around a
+// handler (DOS_LockCode above) are not enough: GCC may emit functions in
+// any order. Instead, DOS_IRQ_CODE puts a function in .text.dosirq_b, and
+// DOS_IRQ_CODE_RANGE(tag), at file scope ahead of every function, opens
+// .text.dosirq_a (a begin label), .text.dosirq_b and .text.dosirq_c (an
+// end label) in that order: GCC emits top-level asm before any function,
+// the object keeps its sections in the order they were opened, and the
+// link keeps each object's order, so the file's handler code lands
+// between the two labels. Handler code may only call DOS_IRQ_CODE
+// functions of its own file and SDL_FORCE_INLINE helpers, and must not
+// use a switch (its jump table would go to plain .text).
+#define DOS_IRQ_CODE __attribute__((section(".text.dosirq_b")))
+
+#define DOS_IRQ_CODE_RANGE(tag) \
+    __asm__(".section .text.dosirq_a,\"x\"\n" \
+            "_dosIrqBegin_" #tag ":\n\t.byte 0xc3\n" \
+            ".section .text.dosirq_b,\"x\"\n" \
+            ".section .text.dosirq_c,\"x\"\n" \
+            "_dosIrqEnd_" #tag ":\n\t.byte 0xc3\n" \
+            ".text\n"); \
+    extern char dosIrqBegin_##tag[], dosIrqEnd_##tag[]
+
+#define DOS_LockIRQCode(tag) \
+    _go32_dpmi_lock_code(dosIrqBegin_##tag, dosIrqEnd_##tag - dosIrqBegin_##tag + 1)
+
+// Defined (as 1) by this version of SDL, whose handlers lock their code
+// with DOS_IRQ_CODE: an application that needs that can reference it.
+extern const int DOS_IRQCodeLocked;
+
+// Port I/O for handler code, inlined whatever the optimization level
+// (djgpp's inportb()/outportb() are extern inline: GCC may call libc's
+// copies instead, which are not locked).
+SDL_FORCE_INLINE Uint8 DOS_InPort8(Uint16 port)
+{
+    Uint8 v;
+    __asm__ __volatile__("inb %1, %0" : "=a"(v) : "Nd"(port));
+    return v;
+}
+
+SDL_FORCE_INLINE void DOS_OutPort8(Uint16 port, Uint8 v)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(v), "Nd"(port));
+}
+
 // Lock a range of data so it won't be paged out during interrupts.
 #define DOS_LockData(var, size) \
     _go32_dpmi_lock_data((void *)&(var), (size))
@@ -115,9 +162,9 @@ SDL_FORCE_INLINE Uint32 DOS_PeekUint32(const Uint32 segoffset)
 SDL_FORCE_INLINE void DOS_EndOfInterrupt(int irq)
 {
     if (irq > 7) {
-        outportb(PIC2_COMMAND, PIC_EOI);
+        DOS_OutPort8(PIC2_COMMAND, PIC_EOI);
     }
-    outportb(PIC1_COMMAND, PIC_EOI);
+    DOS_OutPort8(PIC1_COMMAND, PIC_EOI);
 }
 
 // Allocate memory under the 640k line; various real mode services and DMA transfers need this.
diff --git a/src/video/dos/SDL_dosevents.c b/src/video/dos/SDL_dosevents.c
index 9372f35..6567496 100644
--- a/src/video/dos/SDL_dosevents.c
+++ b/src/video/dos/SDL_dosevents.c
@@ -35,6 +35,9 @@
 // PS/2 keyboard controller port
 #define KBD_DATA_PORT 0x60
 
+// The keyboard interrupt handler's code (DOS_IRQ_CODE below), locked as one range.
+DOS_IRQ_CODE_RANGE(kbd);
+
 // Scancode byte structure
 #define SCANCODE_MASK    0x7F // bits 0-6: scancode index
 #define SCANCODE_RELEASE 0x80 // bit 7: key released (break code)
@@ -370,20 +373,19 @@ void DOSVESA_PumpEvents(SDL_VideoDevice *device)
     }
 }
 
-static void KeyboardIRQHandler(void) // this is wrapped in a thing that handles IRET, etc.
+static DOS_IRQ_CODE void KeyboardIRQHandler(void) // this is wrapped in a thing that handles IRET, etc.
 {
-    keyevents_ringbuffer[keyevents_head] = inportb(KBD_DATA_PORT);
+    keyevents_ringbuffer[keyevents_head] = DOS_InPort8(KBD_DATA_PORT);
     keyevents_head = (keyevents_head + 1) & (SDL_arraysize(keyevents_ringbuffer) - 1);
     DOS_EndOfInterrupt(1);
 }
-static void KeyboardIRQHandler_End(void) {} // end-of-ISR label for memory locking
 
 void DOSVESA_InitKeyboard(SDL_VideoDevice *device)
 {
     SDL_VideoData *data = device->internal;
 
     // Lock ISR code and data to prevent page faults during interrupts
-    DOS_LockCode(KeyboardIRQHandler, KeyboardIRQHandler_End);
+    DOS_LockIRQCode(kbd);
     DOS_LockVariable(keyevents_ringbuffer);
     DOS_LockVariable(keyevents_head);
     DOS_LockVariable(keyevents_tail);
