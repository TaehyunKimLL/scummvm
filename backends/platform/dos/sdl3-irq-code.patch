diff --git a/src/core/dos/SDL_dos.c b/src/core/dos/SDL_dos.c
index 0ba0773..cbe07a6 100644
--- a/src/core/dos/SDL_dos.c
+++ b/src/core/dos/SDL_dos.c
@@ -24,6 +24,35 @@
 
 #include "SDL_dos.h"
 
+const int DOS_IRQCodeLocked = 1;
+const int DOS_IRQCodeChecked = 1;
+
+// The end of the program's code (the djgpp link script's etext); it starts
+// at 0x1000, after the null page.
+extern char etext[];
+
+bool DOS_LockIRQCodeRange(const char *begin, const char *end, const void *const *handlers, int count, const char *what)
+{
+    bool inside = begin < end && end - begin < 64 * 1024;
+    int i;
+    for (i = 0; inside && i < count; i++) {
+        inside = (const char *)handlers[i] > begin && (const char *)handlers[i] < end;
+    }
+    if (!inside) {
+        SDL_Log("DOS: %s interrupt code is not where it should be; locking all code", what);
+        if (_go32_dpmi_lock_code((void *)0x1000, (unsigned long)(etext - (char *)0x1000)) != 0) {
+            SDL_Log("DOS: could not lock the program's code for %s", what);
+            return false;
+        }
+        return true;
+    }
+    if (_go32_dpmi_lock_code((void *)begin, (unsigned long)(end - begin + 1)) != 0) {
+        SDL_Log("DOS: could not lock %s interrupt code", what);
+        return false;
+    }
+    return true;
+}
+
 void *DOS_AllocateConventionalMemory(const int len, _go32_dpmi_seginfo *seginfo)
 {
     seginfo->size = (len + 15) / 16; // this is in "paragraphs"
@@ -32,8 +61,8 @@ void *DOS_AllocateConventionalMemory(const int len, _go32_dpmi_seginfo *seginfo)
         return NULL;
     }
     // No need to lock: DPMI 0.9 §3.3 guarantees the first megabyte is always
-    // committed and locked. CWSDPMI (the DJGPP DPMI host) doesn't support
-    // virtual memory at all, so conventional memory is never paged out.
+    // committed and locked. CWSDPMI (the DJGPP DPMI host) pages extended
+    // memory only; conventional memory is never paged out.
     return DOS_PhysicalToLinear(seginfo->rm_segment * 16);
 }
 
diff --git a/src/core/dos/SDL_dos.h b/src/core/dos/SDL_dos.h
index 11dc58d..d521d8b 100644
--- a/src/core/dos/SDL_dos.h
+++ b/src/core/dos/SDL_dos.h
@@ -53,6 +53,63 @@
 #define DOS_LockCode(start, end) \
     _go32_dpmi_lock_code((void *)(start), (char *)(end) - (char *)(start))
 
+// Interrupt handler code, locked as one range per source file.
+//
+// A page fault is fatal in a hardware interrupt that came in real mode, so
+// whatever runs there must be locked. Marker functions placed around a
+// handler (DOS_LockCode above) are not enough: GCC may emit functions in
+// any order. Instead, DOS_IRQ_CODE puts a function in .text.dosirq_b, and
+// DOS_IRQ_CODE_RANGE(tag), at file scope ahead of every function, opens
+// .text.dosirq_a (a begin label), .text.dosirq_b and .text.dosirq_c (an
+// end label) in that order: GCC emits top-level asm before any function,
+// the object keeps its sections in the order they were opened, and the
+// link keeps each object's order, so the file's handler code lands
+// between the two labels. Handler code may only call DOS_IRQ_CODE
+// functions of its own file and SDL_FORCE_INLINE helpers, and must not
+// use a switch (its jump table would go to plain .text).
+#define DOS_IRQ_CODE __attribute__((section(".text.dosirq_b")))
+
+#define DOS_IRQ_CODE_RANGE(tag) \
+    __asm__(".section .text.dosirq_a,\"x\"\n" \
+            "_dosIrqBegin_" #tag ":\n\t.byte 0xc3\n" \
+            ".section .text.dosirq_b,\"x\"\n" \
+            ".section .text.dosirq_c,\"x\"\n" \
+            "_dosIrqEnd_" #tag ":\n\t.byte 0xc3\n" \
+            ".text\n"); \
+    extern char dosIrqBegin_##tag[], dosIrqEnd_##tag[]
+
+// Locks the handler code of the file that has DOS_IRQ_CODE_RANGE(tag), once
+// each of the `count` functions in `handlers` is seen to lie between its
+// labels. If one does not, the link did not lay the sections out as
+// expected, and all of the program's code is locked instead. Returns false
+// if a lock failed: the handlers must not go in then.
+#define DOS_LockIRQCode(tag, handlers, count) \
+    DOS_LockIRQCodeRange(dosIrqBegin_##tag, dosIrqEnd_##tag, (handlers), (count), #tag)
+
+// Defined (as 1) by this version of SDL, whose handlers lock their code
+// with DOS_IRQ_CODE: an application that needs that can reference it.
+extern const int DOS_IRQCodeLocked;
+
+// Defined (as 1) by this version of SDL, which also checks that each
+// handler lies inside its locked range and that the locks took
+// (DOS_LockIRQCode): an application that needs that can reference it.
+extern const int DOS_IRQCodeChecked;
+
+// Port I/O for handler code, inlined whatever the optimization level
+// (djgpp's inportb()/outportb() are extern inline: GCC may call libc's
+// copies instead, which are not locked).
+SDL_FORCE_INLINE Uint8 DOS_InPort8(Uint16 port)
+{
+    Uint8 v;
+    __asm__ __volatile__("inb %1, %0" : "=a"(v) : "Nd"(port));
+    return v;
+}
+
+SDL_FORCE_INLINE void DOS_OutPort8(Uint16 port, Uint8 v)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(v), "Nd"(port));
+}
+
 // Lock a range of data so it won't be paged out during interrupts.
 #define DOS_LockData(var, size) \
     _go32_dpmi_lock_data((void *)&(var), (size))
@@ -115,9 +172,9 @@ SDL_FORCE_INLINE Uint32 DOS_PeekUint32(const Uint32 segoffset)
 SDL_FORCE_INLINE void DOS_EndOfInterrupt(int irq)
 {
     if (irq > 7) {
-        outportb(PIC2_COMMAND, PIC_EOI);
+        DOS_OutPort8(PIC2_COMMAND, PIC_EOI);
     }
-    outportb(PIC1_COMMAND, PIC_EOI);
+    DOS_OutPort8(PIC1_COMMAND, PIC_EOI);
 }
 
 // Allocate memory under the 640k line; various real mode services and DMA transfers need this.
@@ -131,6 +188,9 @@ extern void *DOS_AllocateDMAMemory(const int len, _go32_dpmi_seginfo *seginfo);
 // Free conventional (or DMA, which _is_ conventional) memory.
 extern void DOS_FreeConventionalMemory(_go32_dpmi_seginfo *seginfo);
 
+// See DOS_LockIRQCode.
+extern bool DOS_LockIRQCodeRange(const char *begin, const char *end, const void *const *handlers, int count, const char *what);
+
 // Get a SDL_malloc'd copy of a null-terminated string located at a real-mode segment:offset. This makes no promises about character encoding.
 char *DOS_GetFarPtrCString(const Uint32 segoffset);
 
