diff --git a/backends/platform/dos/sdl3/0015-dos-Place-the-DMA-buffer-inside-one-64-KB-page-for-a.patch b/backends/platform/dos/sdl3/0015-dos-Place-the-DMA-buffer-inside-one-64-KB-page-for-a.patch
new file mode 100644
index 000000000..c381d4bdf
--- /dev/null
+++ b/backends/platform/dos/sdl3/0015-dos-Place-the-DMA-buffer-inside-one-64-KB-page-for-a.patch
@@ -0,0 +1,104 @@
+From b82beef6c0eb11465d7790cec98ad64afa667cd1 Mon Sep 17 00:00:00 2001
+From: Taehyun Kim <dice.thkim@gmail.com>
+Date: Tue, 24 Nov 2026 02:54:58 +0000
+Subject: [PATCH] dos: Place the DMA buffer inside one 64 KB page for any
+ length, unlock what was locked
+
+DOS_AllocateDMAMemory() chose the start of the 2*len block or its second
+half, which is only right up to 32 KB; the audio driver may ask for 64 KB.
+It now takes the first of: block start, second half, next page boundary,
+that keeps the region in one physical page, and fails (freeing the block)
+if none does. Exhaustive model over every segment and 177,078,272
+(segment, length) cases: 0 crossing regions, 0 refusals that were avoidable.
+DOS_DisableInterrupts/EnableInterrupts get a "memory" clobber so the compiler
+cannot move accesses across them; DOS_UnlockData undoes DOS_LockData.
+---
+ src/core/dos/SDL_dos.c | 31 ++++++++++++++++++++++++++-----
+ src/core/dos/SDL_dos.h | 10 ++++++++--
+ 2 files changed, 34 insertions(+), 7 deletions(-)
+
+diff --git a/src/core/dos/SDL_dos.c b/src/core/dos/SDL_dos.c
+index cbe07a615..023ad5611 100644
+--- a/src/core/dos/SDL_dos.c
++++ b/src/core/dos/SDL_dos.c
+@@ -79,12 +79,33 @@ void *DOS_AllocateDMAMemory(const int len, _go32_dpmi_seginfo *seginfo)
+         return NULL;
+     }
+ 
+-    // if we're past the end of a page, use the second half of the block.
+-    const uint32_t physical = (seginfo->rm_segment * 16);
+-    if ((physical >> 16) != ((physical + len) >> 16)) {
+-        ptr += len;
++    // Pick a `len`-byte region of the 2*len block that stays inside one 64 KB physical page: the start of the block, the
++    // second half, or the next page boundary, whichever is the first that fits (for len up to 64 KB the first two alone
++    // are not enough). None fits only if the block cannot hold one: fail instead of risking a transfer across a page.
++    const uint32_t physical = (uint32_t)seginfo->rm_segment * 16;
++    const uint32_t up = ((physical + 0xFFFF) & ~0xFFFFu) - physical; // offset of the next page boundary (0 if aligned)
++    const uint32_t offsets[3] = { 0, (uint32_t)len, up };
++    for (int i = 0; i < 3; i++) {
++        const uint32_t off = offsets[i];
++        if (off + (uint32_t)len <= (uint32_t)len * 2 && ((physical + off) >> 16) == ((physical + off + (uint32_t)len - 1) >> 16)) {
++            return ptr + off;
++        }
++    }
++    DOS_FreeConventionalMemory(seginfo);
++    return NULL;
++}
++
++
++void DOS_UnlockRange(void *ptr, size_t size)
++{
++    unsigned long base = 0;
++    if (__dpmi_get_segment_base_address(_my_ds(), &base) == 0) {
++        __dpmi_meminfo mi;
++        mi.handle = 0;
++        mi.address = base + (unsigned long)ptr;
++        mi.size = (unsigned long)size;
++        __dpmi_unlock_linear_region(&mi);
+     }
+-    return ptr;
+ }
+ 
+ void DOS_FreeConventionalMemory(_go32_dpmi_seginfo *seginfo)
+diff --git a/src/core/dos/SDL_dos.h b/src/core/dos/SDL_dos.h
+index d521d8ba1..5345a9ba7 100644
+--- a/src/core/dos/SDL_dos.h
++++ b/src/core/dos/SDL_dos.h
+@@ -114,6 +114,10 @@ SDL_FORCE_INLINE void DOS_OutPort8(Uint16 port, Uint8 v)
+ #define DOS_LockData(var, size) \
+     _go32_dpmi_lock_data((void *)&(var), (size))
+ 
++// Undo DOS_LockData() for the same range (the DPMI host counts locks).
++#define DOS_UnlockData(var, size) \
++    DOS_UnlockRange((void *)&(var), (size))
++
+ // Lock a single variable.
+ #define DOS_LockVariable(var) \
+     DOS_LockData(var, sizeof(var))
+@@ -123,6 +127,8 @@ SDL_FORCE_INLINE void DOS_OutPort8(Uint16 port, Uint8 v)
+ extern "C" {
+ #endif
+ 
++extern void DOS_UnlockRange(void *ptr, size_t size);
++
+ // This uses the "fat DS" trick to convert a physical address to a valid
+ //  C pointer usable from protected mode.
+ SDL_FORCE_INLINE void *DOS_PhysicalToLinear(const Uint32 physical)
+@@ -143,12 +149,12 @@ SDL_FORCE_INLINE int DOS_IRQToVector(int irq)
+ 
+ SDL_FORCE_INLINE void DOS_DisableInterrupts(void)
+ {
+-    __asm__ __volatile__("cli\n");
++    __asm__ __volatile__("cli\n" : : : "memory");
+ }
+ 
+ SDL_FORCE_INLINE void DOS_EnableInterrupts(void)
+ {
+-    __asm__ __volatile__("sti\n");
++    __asm__ __volatile__("sti\n" : : : "memory");
+ }
+ 
+ // Grab a single byte from a segment:offset.
+-- 
+2.43.0
+
diff --git a/backends/platform/dos/sdl3/0016-dos-Harden-the-Sound-Blaster-driver-units-rates-rang.patch b/backends/platform/dos/sdl3/0016-dos-Harden-the-Sound-Blaster-driver-units-rates-rang.patch
new file mode 100644
index 000000000..38b0d55f5
--- /dev/null
+++ b/backends/platform/dos/sdl3/0016-dos-Harden-the-Sound-Blaster-driver-units-rates-rang.patch
@@ -0,0 +1,448 @@
+From 35cda100762ae8c9a6ab93f033d5ee849d3bd10b Mon Sep 17 00:00:00 2001
+From: Taehyun Kim <dice.thkim@gmail.com>
+Date: Tue, 24 Nov 2026 02:54:58 +0000
+Subject: [PATCH] dos: Harden the Sound Blaster driver (units, rates, ranges,
+ cursors, close)
+
+- CheckForSoundBlaster and the DSP reset used SDL_DelayPrecise() with
+  microsecond/millisecond counts, but it takes nanoseconds: the 300 ms wait was
+  about 0.3 ms and the 3 us reset pulse 3 ns. Both use real deadlines now (the
+  pulse is 20 us).
+- BLASTER A/I/D/H are range-checked (port 0x200-0x2F0, IRQ 0-15 but 2, DMA
+  8-bit 0/1/3, 16-bit 5-7); a bad value is ignored with a log line.
+- Pre-SB16 time constant is rounded, kept in range (rates below 4 kHz no
+  longer wrap it into high-speed), high-speed needs DSP >= 2.01, and the real
+  rate is reported as the device rate (SB Pro stereo at 22,050 Hz ran 1.4% off
+  after rounding, 3.1% before); SB16 rates clamp to 5000..44100.
+- The SB16 close sends 0xD5/0xD9 (the 16-bit commands) instead of the 8-bit
+  0xDA; a failed open clears the SB Pro stereo bit.
+- Ring cursors are free-running Uint32 with unsigned differences (the int
+  cursors overflowed after about 3.4 hours); the cursors' model test: 4,000,000
+  checks across the wrap, 0 bad. DOS_SBGetStats reads under cli into locals.
+  isr_dma_channel is volatile.
+- The DMA probe first checks whether the configured channel's count register
+  moves (then the IRQ is wrong, nothing is reprogrammed), and reprograms with
+  interrupts off; the remaining risk is documented in the code.
+- The handler ignores an SB16 interrupt that only the MPU-401 raised (mixer
+  status 0x82), and the locked ring is unlocked on close.
+---
+ src/audio/dos/SDL_dosaudio_sb.c | 173 ++++++++++++++++++++++++++------
+ src/audio/dos/SDL_dosaudio_sb.h |   5 +-
+ 2 files changed, 145 insertions(+), 33 deletions(-)
+
+diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
+index 61b510acc..efdcd032f 100644
+--- a/src/audio/dos/SDL_dosaudio_sb.c
++++ b/src/audio/dos/SDL_dosaudio_sb.c
+@@ -47,7 +47,7 @@ static void ResetSoundBlasterDSP(void)
+     // reset the DSP.
+     const int reset_port = soundblaster_base_port + 0x6;
+     outportb(reset_port, 1);
+-    SDL_DelayPrecise(3000); // wait at least 3 microseconds for hardware to see it.
++    SDL_DelayPrecise(SDL_US_TO_NS(20)); // the DSP needs the pulse high for at least 3 microseconds (SDL_DelayPrecise takes nanoseconds); 20 leaves margin
+     outportb(reset_port, 0);
+ }
+ 
+@@ -98,20 +98,21 @@ const int DOS_SBRingChunks = RING_BUFFER_CHUNKS;
+ 
+ // ISR-cached copies of device state (avoids chasing heap pointers in IRQ context).
+ static volatile int isr_irq_ack_port = 0;
++static volatile int isr_mixer_base = 0; // base + 4: the SB16 mixer's index port (data at +1), for the interrupt status register
+ static volatile int isr_irq_count = 0; // interrupts seen, for telling whether the card plays at all
+ static volatile int isr_underruns = 0;          // interrupts that found the ring empty (played silence)
+ static volatile int isr_min_avail = 0x7fffffff; // least ring data at an interrupt since the last reset
+ 
+ // ISR-visible ring buffer state (all memory-locked).
+-static volatile int isr_ring_read = 0;
+-static volatile int isr_ring_write = 0;
++static volatile Uint32 isr_ring_read = 0;  // free-running byte counts, wrapping at 2^32: differences are exact in unsigned arithmetic
++static volatile Uint32 isr_ring_write = 0;
+ static int isr_ring_size = 0;         // ring_size (power-of-2 bytes)
+ static int isr_ring_mask = 0;         // ring_size - 1
+ static int isr_chunk_size = 0;        // one DMA half-buffer, in bytes
+ static Uint8 *isr_ring_buffer = NULL; // the ring itself (allocated and locked)
+ static Uint8 *isr_dma_buffer = NULL;  // pointer to the DMA double-buffer
+ static int isr_dma_halfdma = 0;       // half the DMA buffer size, in bytes
+-static int isr_dma_channel = 0;
++static volatile int isr_dma_channel = 0;
+ static bool isr_is_16bit = false;
+ static Uint8 isr_silence_value = 0;
+ 
+@@ -128,10 +129,10 @@ SDL_FORCE_INLINE void ISR_Fill(Uint8 *dst, Uint8 value, int len)
+ 
+ // Copy `len` bytes from the ring buffer at position `pos` into `dst`,
+ // handling the power-of-2 wrap. All pointers are memory-locked.
+-static DOS_IRQ_CODE void RingCopyOut(Uint8 *dst, int pos, int len)
++static DOS_IRQ_CODE void RingCopyOut(Uint8 *dst, Uint32 pos, int len)
+ {
+     const int mask = isr_ring_mask;
+-    const int start = pos & mask;
++    const int start = (int)(pos & (Uint32)mask);
+     const int first = (start + len <= isr_ring_size) ? len : (isr_ring_size - start);
+     ISR_Copy(dst, isr_ring_buffer + start, first);
+     if (first < len) {
+@@ -166,6 +167,17 @@ static DOS_IRQ_CODE Uint8 *ISR_GetDMAHalf(void)
+ // copies. No DPMI, no malloc, no mutex, no FPU.
+ static DOS_IRQ_CODE void SoundBlasterIRQHandler(void)
+ {
++    // The SB16 shares its IRQ with the MPU-401 (and a spurious IRQ 7/15 can arrive): when the interrupt status register
++    // (mixer 0x82) says only the MPU-401 asked (bit 2, none of the DSP's bits 0-1), it is not ours: end it and leave
++    // the card's acknowledge alone. A card whose register reads 0 is treated as ours, as before.
++    if (isr_is_16bit && isr_mixer_base) {
++        DOS_OutPort8(isr_mixer_base, 0x82);
++        const Uint8 st = DOS_InPort8(isr_mixer_base + 1);
++        if ((st & 0x04) && !(st & 0x03)) {
++            DOS_EndOfInterrupt(soundblaster_irq);
++            return;
++        }
++    }
+     // Acknowledge hardware first.
+     DOS_InPort8(isr_irq_ack_port);
+     DOS_EndOfInterrupt(soundblaster_irq);
+@@ -174,7 +186,7 @@ static DOS_IRQ_CODE void SoundBlasterIRQHandler(void)
+     Uint8 *dma_dst = ISR_GetDMAHalf();
+ 
+     // How many bytes are available in the ring?
+-    const int avail = isr_ring_write - isr_ring_read; // both are monotonic
++    const int avail = (int)(Uint32)(isr_ring_write - isr_ring_read); // free-running Uint32 counts: exact across the 2^32 wrap
+     if (avail < isr_min_avail) {
+         isr_min_avail = avail;
+     }
+@@ -217,7 +229,7 @@ static bool DOSSOUNDBLASTER_WaitDevice(SDL_AudioDevice *device)
+         // Available space = size (the fill limit) - (write - read).
+         // ring_write is ours (audio thread only), ring_read is advanced by
+         // the ISR. Read the ISR's copy so we see the latest drain position.
+-        const int used = hidden->ring_write - isr_ring_read;
++        const int used = (int)(Uint32)(hidden->ring_write - isr_ring_read);
+         if ((size - used) >= hidden->chunk_size) {
+             return true; // room for at least one chunk
+         }
+@@ -236,14 +248,17 @@ static void DOSSOUNDBLASTER_FreeState(struct SDL_PrivateAudioData *hidden)
+     // disable DMA — mask the appropriate DMA channel.
+     if (hidden->dma_buffer) {
+         if (hidden->is_16bit) {
+-            outportb(0xD4, 0x04 | hidden->dma_channel); // mask high DMA channel (channels 5-7)
++            outportb(0xD4, 0x04 | (hidden->dma_channel & 3)); // mask high DMA channel (channels 5-7: bits 0-1 select)
+         } else {
+             outportb(0x0A, 0x04 | hidden->dma_channel); // mask low DMA channel (channels 0-3)
+         }
+         DOS_FreeConventionalMemory(&hidden->dma_seginfo);
+     }
+ 
+-    // Free ring buffer resources.
++    // Free ring buffer resources (it was locked: the lock is undone first, or every open would leak a lock count).
++    if (hidden->ring_locked) {
++        DOS_UnlockData(*hidden->ring_buffer, hidden->ring_size);
++    }
+     SDL_free(hidden->ring_buffer);
+     SDL_free(hidden->staging_buffer);
+ 
+@@ -257,6 +272,7 @@ static void DOSSOUNDBLASTER_FreeState(struct SDL_PrivateAudioData *hidden)
+     isr_dma_buffer = NULL;
+     isr_dma_halfdma = 0;
+     isr_irq_ack_port = 0;
++    isr_mixer_base = 0;
+ 
+     SDL_free(hidden);
+ }
+@@ -264,6 +280,10 @@ static void DOSSOUNDBLASTER_FreeState(struct SDL_PrivateAudioData *hidden)
+ // OpenDevice failed: undo it, so that CloseDevice (which SDL still calls) has nothing left to do.
+ static bool DOSSOUNDBLASTER_OpenFailed(struct SDL_PrivateAudioData *hidden)
+ {
++    if (!hidden->is_16bit && soundblaster_version >= 3) { // StartPlayback may have set the SB Pro's stereo bit
++        outportb(soundblaster_base_port + 0x04, 0x0E);
++        outportb(soundblaster_base_port + 0x05, inportb(soundblaster_base_port + 0x05) & ~0x02);
++    }
+     DOSSOUNDBLASTER_FreeState(hidden);
+     return false;
+ }
+@@ -292,21 +312,28 @@ const int DOS_SBStatsChecked = 1;
+ extern void DOS_SBGetStats(int *irqs, int *underruns, int *queued, int *min_avail, int *chunk, int reset_min);
+ void DOS_SBGetStats(int *irqs, int *underruns, int *queued, int *min_avail, int *chunk, int reset_min)
+ {
++    int l_irqs, l_under, l_queued, l_min, l_chunk;
+     DOS_DisableInterrupts();
+-    *irqs = isr_irq_count;
+-    *underruns = isr_underruns;
+-    *queued = isr_ring_write - isr_ring_read;
+-    *min_avail = (isr_min_avail == 0x7fffffff) ? -1 : isr_min_avail;
+-    *chunk = isr_chunk_size;
++    l_irqs = isr_irq_count;
++    l_under = isr_underruns;
++    l_queued = (int)(Uint32)(isr_ring_write - isr_ring_read);
++    l_min = (isr_min_avail == 0x7fffffff) ? -1 : isr_min_avail;
++    l_chunk = isr_chunk_size;
+     if (reset_min) {
+         isr_min_avail = 0x7fffffff;
+     }
+     DOS_EnableInterrupts();
++    *irqs = l_irqs; // the caller's pointers may be pageable memory: touched with interrupts on
++    *underruns = l_under;
++    *queued = l_queued;
++    *min_avail = l_min;
++    *chunk = l_chunk;
+ }
+ 
+ #define SB_PROBE_MS 250
+ 
+ static bool CheckForSoundBlaster(void);
++static void DOSSOUNDBLASTER_TimeConstant(const int channels, const int freq, Uint8 *tc_out, int *real_freq);
+ 
+ // Point the DMA controller at the DMA buffer on `channel` and unmask it.
+ static void DOSSOUNDBLASTER_ProgramDMA(const struct SDL_PrivateAudioData *hidden, const int channel)
+@@ -317,7 +344,7 @@ static void DOSSOUNDBLASTER_ProgramDMA(const struct SDL_PrivateAudioData *hidden
+     if (hidden->is_16bit) {
+         // High DMA (16-bit, channels 5-7): ports in 0xC0-0xDF range, counts in words.
+         const int dma_words = (hidden->dma_buflen / 2) - 1;
+-        outportb(0xD4, 0x04 | channel);                                           // mask the DMA channel
++        outportb(0xD4, 0x04 | (channel & 3));                                     // mask the DMA channel
+         outportb(0xD6, 0x58 | (channel - 4));                                     // mode: single, read, auto-init
+         static const int high_page_ports[] = { 0, 0, 0, 0, 0, 0x8B, 0x89, 0x8A }; // DMA page register ports for channels 5-7
+         outportb(high_page_ports[channel], physical_page);                        // page to transfer
+@@ -378,8 +405,9 @@ static void DOSSOUNDBLASTER_StartPlayback(const SDL_AudioDevice *device, struct
+         // Time Constant = 256 - (1000000 / (channels * freq))
+         // In stereo mode the SB Pro interleaves L/R samples, so the effective
+         // hardware rate is channels * freq.
+-        const int effective_rate = device->spec.channels * device->spec.freq;
+-        const Uint8 time_constant = (Uint8)(256 - (1000000 / effective_rate));
++        Uint8 time_constant;
++        int real_freq;
++        DOSSOUNDBLASTER_TimeConstant(device->spec.channels, device->spec.freq, &time_constant, &real_freq);
+         WriteSoundBlasterDSP(0x40); // set time constant
+         WriteSoundBlasterDSP(time_constant);
+ 
+@@ -407,7 +435,7 @@ static void DOSSOUNDBLASTER_StartPlayback(const SDL_AudioDevice *device, struct
+         // Normal-speed DMA tops out near 23 kHz (DOSBox-X clamps the time constant
+         // to 212): above that the high-speed command is needed. In high-speed mode
+         // the DSP takes no command but a reset until the transfer is stopped.
+-        hidden->highspeed = (time_constant > 212);
++        hidden->highspeed = (time_constant > 212) && ((soundblaster_version > 2) || (soundblaster_version == 2 && soundblaster_version_minor >= 1));
+         WriteSoundBlasterDSP(hidden->highspeed ? 0x90 : 0x1C); // 8-bit auto-init DMA playback
+     }
+ }
+@@ -446,11 +474,33 @@ static bool DOSSOUNDBLASTER_RestartOnChannel(const SDL_AudioDevice *device, stru
+     hidden->dma_channel = channel;
+     isr_dma_channel = channel;
+     DOS_EnableInterrupts();
++    DOS_DisableInterrupts(); // the handler resets the DMA flip-flop: no interrupt in the middle of the register writes
+     DOSSOUNDBLASTER_ProgramDMA(hidden, channel);
++    DOS_EnableInterrupts();
+     DOSSOUNDBLASTER_StartPlayback(device, hidden);
+     return true;
+ }
+ 
++// Whether the 8-bit DMA channel's current-count register moves between two readings 5 ms apart: the transfer runs, so the
++// card and the DMA controller agree and the missing interrupt is the IRQ's fault, not the channel's. The reads are
++// with interrupts off (the flip-flop is shared with the handler's reads).
++static bool DOSSOUNDBLASTER_DMACountMoves(const int channel)
++{
++    int first, second;
++    DOS_DisableInterrupts();
++    outportb(0x0C, 0x00);
++    first = inportb(channel * 2 + 1);
++    first |= inportb(channel * 2 + 1) << 8;
++    DOS_EnableInterrupts();
++    SDL_DelayPrecise(SDL_MS_TO_NS(5));
++    DOS_DisableInterrupts();
++    outportb(0x0C, 0x00);
++    second = inportb(channel * 2 + 1);
++    second |= inportb(channel * 2 + 1) << 8;
++    DOS_EnableInterrupts();
++    return first != second;
++}
++
+ // The first start produced no interrupt. Pre-SB16 cards wired to another 8-bit DMA channel than BLASTER's D
+ // (some PnP and clone chipsets) get a try on each of the other usable channels.
+ static bool DOSSOUNDBLASTER_ProbeDMAChannel(const SDL_AudioDevice *device, struct SDL_PrivateAudioData *hidden)
+@@ -458,7 +508,16 @@ static bool DOSSOUNDBLASTER_ProbeDMAChannel(const SDL_AudioDevice *device, struc
+     const int configured = hidden->dma_channel;
+     const int timeout_ms = DOSSOUNDBLASTER_ProbeTimeoutMS(device, hidden);
+ 
++    if (!hidden->is_16bit && DOSSOUNDBLASTER_DMACountMoves(configured)) {
++        // The DMA transfer runs on the configured channel: BLASTER's D is right and the interrupt (BLASTER's I) is what is
++        // wrong. Reprogramming other channels would only disturb their owners (the floppy-less machine's ECP port, a GUS,
++        // the second DMA channel of a WSS card): do not probe.
++        SDL_Log("SB: DMA %d is moving but no interrupt arrives (check BLASTER's I)", configured);
++        return true;
++    }
+     if (!hidden->is_16bit) {
++        // Remaining risk: a candidate channel is reprogrammed (mode, address, count) and left masked; a device that
++        // was using it, and whose state is not readable from the 8237, is not restored.
+         static const int candidates[] = { 0, 1, 3 }; // 2 is the floppy controller's, 4 cascades the controllers
+         for (int i = 0; i < (int)SDL_arraysize(candidates); i++) {
+             const int channel = candidates[i];
+@@ -483,6 +542,24 @@ static bool DOSSOUNDBLASTER_ProbeDMAChannel(const SDL_AudioDevice *device, struc
+     return true;
+ }
+ 
++// Pre-SB16 rate: the time constant is 256 - 1000000 / (channels * rate), rounded to the nearest, and the rate the card then
++// really runs at is 1000000 / (256 - tc) / channels. The hardware rate is kept to what the DSP does: 4 kHz and up; below
++// 23 kHz (time constant <= 211) normal DMA, above it the high-speed command, which exists only from DSP 2.01.
++static void DOSSOUNDBLASTER_TimeConstant(const int channels, const int freq, Uint8 *tc_out, int *real_freq)
++{
++    const bool highspeed_ok = (soundblaster_version > 2) || (soundblaster_version == 2 && soundblaster_version_minor >= 1);
++    const int max_hw = highspeed_ok ? 44100 : 23000;
++    int hw = channels * freq;
++    hw = SDL_clamp(hw, 4000, max_hw);
++    int tc = 256 - ((1000000 + (hw / 2)) / hw);
++    if (!highspeed_ok && tc > 211) {
++        tc = 211;
++    }
