From 94176e2ac8a751fa9c7d0fbe7e6a6154c89cc104 Mon Sep 17 00:00:00 2001
From: Taehyun Kim <dice.thkim@gmail.com>
Date: Sat, 3 Oct 2026 07:06:54 +0000
Subject: [PATCH 08/14] dos: size the Sound Blaster first-interrupt wait to the
 buffer, count from after the reset

Co-Authored-By: Claude Code <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01429qJytiMpcCADjppM2jV4
---
 src/audio/dos/SDL_dosaudio_sb.c | 30 +++++++++++++++++++++---------
 1 file changed, 21 insertions(+), 9 deletions(-)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 6dc334a3b..93424e175 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -362,10 +362,18 @@ static void DOSSOUNDBLASTER_StartPlayback(const SDL_AudioDevice *device, const s
     }
 }
 
-// True once the card raises an interrupt after `irqs_before`, false when SB_PROBE_MS pass without one.
-static bool DOSSOUNDBLASTER_WaitForIRQ(const int irqs_before)
+// A first interrupt takes one DMA half-buffer to arrive, so a big buffer at a low rate needs more than SB_PROBE_MS.
+static int DOSSOUNDBLASTER_ProbeTimeoutMS(const SDL_AudioDevice *device, const struct SDL_PrivateAudioData *hidden)
 {
-    const Uint64 deadline = SDL_GetTicksNS() + SDL_MS_TO_NS(SB_PROBE_MS);
+    const int bytes_per_second = device->spec.freq * SDL_AUDIO_FRAMESIZE(device->spec);
+    const int block_ms = (bytes_per_second > 0) ? (int)(((Sint64)(hidden->dma_buflen / 2) * 1000) / bytes_per_second) : 0;
+    return SDL_max(SB_PROBE_MS, (block_ms * 2) + 100);
+}
+
+// True once the card raises an interrupt after `irqs_before`, false when `timeout_ms` pass without one.
+static bool DOSSOUNDBLASTER_WaitForIRQ(const int irqs_before, const int timeout_ms)
+{
+    const Uint64 deadline = SDL_GetTicksNS() + SDL_MS_TO_NS(timeout_ms);
     while (isr_irq_count == irqs_before) {
         if (SDL_GetTicksNS() >= deadline) {
             return false;
@@ -376,11 +384,13 @@ static bool DOSSOUNDBLASTER_WaitForIRQ(const int irqs_before)
 }
 
 // Reset the DSP and start playing again with the DMA controller on `channel` (8-bit path only).
-static bool DOSSOUNDBLASTER_RestartOnChannel(const SDL_AudioDevice *device, struct SDL_PrivateAudioData *hidden, const int channel)
+// `irqs` receives the interrupt count once the old transfer is dead, the baseline for the next wait.
+static bool DOSSOUNDBLASTER_RestartOnChannel(const SDL_AudioDevice *device, struct SDL_PrivateAudioData *hidden, const int channel, int *irqs)
 {
     if (!CheckForSoundBlaster()) { // resets the DSP and waits for it to come back
         return false;
     }
+    *irqs = isr_irq_count;
     outportb(0x0A, 0x04 | hidden->dma_channel); // the channel we leave
     DOS_DisableInterrupts();
     hidden->dma_channel = channel;
@@ -396,6 +406,7 @@ static bool DOSSOUNDBLASTER_RestartOnChannel(const SDL_AudioDevice *device, stru
 static bool DOSSOUNDBLASTER_ProbeDMAChannel(const SDL_AudioDevice *device, struct SDL_PrivateAudioData *hidden)
 {
     const int configured = hidden->dma_channel;
+    const int timeout_ms = DOSSOUNDBLASTER_ProbeTimeoutMS(device, hidden);
 
     if (!hidden->is_16bit) {
         static const int candidates[] = { 0, 1, 3 }; // 2 is the floppy controller's, 4 cascades the controllers
@@ -404,16 +415,17 @@ static bool DOSSOUNDBLASTER_ProbeDMAChannel(const SDL_AudioDevice *device, struc
             if (channel == configured) {
                 continue;
             }
-            const int irqs = isr_irq_count;
-            if (!DOSSOUNDBLASTER_RestartOnChannel(device, hidden, channel)) {
+            int irqs;
+            if (!DOSSOUNDBLASTER_RestartOnChannel(device, hidden, channel, &irqs)) {
                 return false;
             }
-            if (DOSSOUNDBLASTER_WaitForIRQ(irqs)) {
+            if (DOSSOUNDBLASTER_WaitForIRQ(irqs, timeout_ms)) {
                 SDL_Log("SB: no interrupt on DMA %d, using DMA %d", configured, channel);
                 return true;
             }
         }
-        if (!DOSSOUNDBLASTER_RestartOnChannel(device, hidden, configured)) {
+        int irqs;
+        if (!DOSSOUNDBLASTER_RestartOnChannel(device, hidden, configured, &irqs)) {
             return false;
         }
     }
@@ -573,7 +585,7 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
     const int irqs = isr_irq_count;
     DOSSOUNDBLASTER_StartPlayback(device, hidden);
     // The handler plays silence until the audio thread has mixed something, so this costs no sound.
-    if (DOSSOUNDBLASTER_WaitForIRQ(irqs)) {
+    if (DOSSOUNDBLASTER_WaitForIRQ(irqs, DOSSOUNDBLASTER_ProbeTimeoutMS(device, hidden))) {
         SDL_Log("SB: first interrupt seen, DMA %d", hidden->dma_channel);
     } else if (!DOSSOUNDBLASTER_ProbeDMAChannel(device, hidden)) {
         DOS_UnhookInterrupt(&hidden->interrupt_hook, true);
-- 
