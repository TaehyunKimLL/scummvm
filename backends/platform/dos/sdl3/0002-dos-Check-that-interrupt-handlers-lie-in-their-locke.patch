From d2ed6c8e0bcca6d947a0815b401ac673d7948e35 Mon Sep 17 00:00:00 2001
From: Taehyun Kim <dice.thkim@gmail.com>
Date: Thu, 1 Oct 2026 04:40:33 +0000
Subject: [PATCH 02/14] dos: Check that interrupt handlers lie in their locked
 range, and that the locks took

DOS_LockIRQCode() now takes the file's handler functions and checks that
each lies between its range labels; if one does not, it locks all of the
program's code instead. It returns false when a lock fails, and the Sound
Blaster open fails and the keyboard handler stays out then: a page fault
in a handler is fatal when the interrupt came in real mode. Export
DOS_IRQCodeChecked so an application can require this. Also correct the
comment that said CWSDPMI has no virtual memory.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01429qJytiMpcCADjppM2jV4
---
 src/audio/dos/SDL_dosaudio_sb.c | 38 ++++++++++++++++++++-------------
 src/core/dos/SDL_dos.c          | 31 +++++++++++++++++++++++++--
 src/core/dos/SDL_dos.h          | 17 +++++++++++++--
 src/video/dos/SDL_dosevents.c   | 17 ++++++++++-----
 4 files changed, 79 insertions(+), 24 deletions(-)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index ee19448cd..74064b0b1 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -348,21 +348,29 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
     isr_silence_value = soundblaster_silence_value;
 
     // Lock all ISR code and data to prevent page faults during interrupts.
-    DOS_LockIRQCode(sb);
-    DOS_LockData(*hidden->ring_buffer, hidden->ring_size);
-    DOS_LockVariable(isr_ring_read);
-    DOS_LockVariable(isr_ring_write);
-    DOS_LockVariable(isr_ring_size);
-    DOS_LockVariable(isr_ring_mask);
-    DOS_LockVariable(isr_chunk_size);
-    DOS_LockVariable(isr_ring_buffer);
-    DOS_LockVariable(isr_dma_buffer);
-    DOS_LockVariable(isr_dma_halfdma);
-    DOS_LockVariable(isr_dma_channel);
-    DOS_LockVariable(isr_is_16bit);
-    DOS_LockVariable(isr_silence_value);
-    DOS_LockVariable(isr_irq_ack_port);
-    DOS_LockVariable(soundblaster_irq);
+    // A page fault in the handler is fatal when the interrupt came in real
+    // mode: without the locks, no handler.
+    {
+        static const void *const handlers[] = { (const void *)SoundBlasterIRQHandler };
+        bool locked = DOS_LockIRQCode(sb, handlers, SDL_arraysize(handlers));
+        locked = (DOS_LockData(*hidden->ring_buffer, hidden->ring_size) == 0) && locked;
+        locked = (DOS_LockVariable(isr_ring_read) == 0) && locked;
+        locked = (DOS_LockVariable(isr_ring_write) == 0) && locked;
+        locked = (DOS_LockVariable(isr_ring_size) == 0) && locked;
+        locked = (DOS_LockVariable(isr_ring_mask) == 0) && locked;
+        locked = (DOS_LockVariable(isr_chunk_size) == 0) && locked;
+        locked = (DOS_LockVariable(isr_ring_buffer) == 0) && locked;
+        locked = (DOS_LockVariable(isr_dma_buffer) == 0) && locked;
+        locked = (DOS_LockVariable(isr_dma_halfdma) == 0) && locked;
+        locked = (DOS_LockVariable(isr_dma_channel) == 0) && locked;
+        locked = (DOS_LockVariable(isr_is_16bit) == 0) && locked;
+        locked = (DOS_LockVariable(isr_silence_value) == 0) && locked;
+        locked = (DOS_LockVariable(isr_irq_ack_port) == 0) && locked;
+        locked = (DOS_LockVariable(soundblaster_irq) == 0) && locked;
+        if (!locked) {
+            return SDL_SetError("Couldn't lock the Sound Blaster interrupt handler's memory");
+        }
+    }
 
     DOS_HookInterrupt(soundblaster_irq, SoundBlasterIRQHandler, &hidden->interrupt_hook);
 
diff --git a/src/core/dos/SDL_dos.c b/src/core/dos/SDL_dos.c
index ed133e5fb..cbe07a615 100644
--- a/src/core/dos/SDL_dos.c
+++ b/src/core/dos/SDL_dos.c
@@ -25,6 +25,33 @@
 #include "SDL_dos.h"
 
 const int DOS_IRQCodeLocked = 1;
+const int DOS_IRQCodeChecked = 1;
+
+// The end of the program's code (the djgpp link script's etext); it starts
+// at 0x1000, after the null page.
+extern char etext[];
+
+bool DOS_LockIRQCodeRange(const char *begin, const char *end, const void *const *handlers, int count, const char *what)
+{
+    bool inside = begin < end && end - begin < 64 * 1024;
+    int i;
+    for (i = 0; inside && i < count; i++) {
+        inside = (const char *)handlers[i] > begin && (const char *)handlers[i] < end;
+    }
+    if (!inside) {
+        SDL_Log("DOS: %s interrupt code is not where it should be; locking all code", what);
+        if (_go32_dpmi_lock_code((void *)0x1000, (unsigned long)(etext - (char *)0x1000)) != 0) {
+            SDL_Log("DOS: could not lock the program's code for %s", what);
+            return false;
+        }
+        return true;
+    }
+    if (_go32_dpmi_lock_code((void *)begin, (unsigned long)(end - begin + 1)) != 0) {
+        SDL_Log("DOS: could not lock %s interrupt code", what);
+        return false;
+    }
+    return true;
+}
 
 void *DOS_AllocateConventionalMemory(const int len, _go32_dpmi_seginfo *seginfo)
 {
@@ -34,8 +61,8 @@ void *DOS_AllocateConventionalMemory(const int len, _go32_dpmi_seginfo *seginfo)
         return NULL;
     }
     // No need to lock: DPMI 0.9 §3.3 guarantees the first megabyte is always
-    // committed and locked. CWSDPMI (the DJGPP DPMI host) doesn't support
-    // virtual memory at all, so conventional memory is never paged out.
+    // committed and locked. CWSDPMI (the DJGPP DPMI host) pages extended
+    // memory only; conventional memory is never paged out.
     return DOS_PhysicalToLinear(seginfo->rm_segment * 16);
 }
 
diff --git a/src/core/dos/SDL_dos.h b/src/core/dos/SDL_dos.h
index 05b30dcdb..d521d8ba1 100644
--- a/src/core/dos/SDL_dos.h
+++ b/src/core/dos/SDL_dos.h
@@ -78,13 +78,23 @@
             ".text\n"); \
     extern char dosIrqBegin_##tag[], dosIrqEnd_##tag[]
 
-#define DOS_LockIRQCode(tag) \
-    _go32_dpmi_lock_code(dosIrqBegin_##tag, dosIrqEnd_##tag - dosIrqBegin_##tag + 1)
+// Locks the handler code of the file that has DOS_IRQ_CODE_RANGE(tag), once
+// each of the `count` functions in `handlers` is seen to lie between its
+// labels. If one does not, the link did not lay the sections out as
+// expected, and all of the program's code is locked instead. Returns false
+// if a lock failed: the handlers must not go in then.
+#define DOS_LockIRQCode(tag, handlers, count) \
+    DOS_LockIRQCodeRange(dosIrqBegin_##tag, dosIrqEnd_##tag, (handlers), (count), #tag)
 
 // Defined (as 1) by this version of SDL, whose handlers lock their code
 // with DOS_IRQ_CODE: an application that needs that can reference it.
 extern const int DOS_IRQCodeLocked;
 
+// Defined (as 1) by this version of SDL, which also checks that each
+// handler lies inside its locked range and that the locks took
+// (DOS_LockIRQCode): an application that needs that can reference it.
+extern const int DOS_IRQCodeChecked;
+
 // Port I/O for handler code, inlined whatever the optimization level
 // (djgpp's inportb()/outportb() are extern inline: GCC may call libc's
 // copies instead, which are not locked).
@@ -178,6 +188,9 @@ extern void *DOS_AllocateDMAMemory(const int len, _go32_dpmi_seginfo *seginfo);
 // Free conventional (or DMA, which _is_ conventional) memory.
 extern void DOS_FreeConventionalMemory(_go32_dpmi_seginfo *seginfo);
 
+// See DOS_LockIRQCode.
+extern bool DOS_LockIRQCodeRange(const char *begin, const char *end, const void *const *handlers, int count, const char *what);
+
 // Get a SDL_malloc'd copy of a null-terminated string located at a real-mode segment:offset. This makes no promises about character encoding.
 char *DOS_GetFarPtrCString(const Uint32 segoffset);
 
diff --git a/src/video/dos/SDL_dosevents.c b/src/video/dos/SDL_dosevents.c
index 656749677..f558deaf8 100644
--- a/src/video/dos/SDL_dosevents.c
+++ b/src/video/dos/SDL_dosevents.c
@@ -384,11 +384,18 @@ void DOSVESA_InitKeyboard(SDL_VideoDevice *device)
 {
     SDL_VideoData *data = device->internal;
 
-    // Lock ISR code and data to prevent page faults during interrupts
-    DOS_LockIRQCode(kbd);
-    DOS_LockVariable(keyevents_ringbuffer);
-    DOS_LockVariable(keyevents_head);
-    DOS_LockVariable(keyevents_tail);
+    // Lock ISR code and data to prevent page faults during interrupts. A
+    // page fault in the handler is fatal when the interrupt came in real
+    // mode: without the locks, no handler (and no keyboard).
+    static const void *const handlers[] = { (const void *)KeyboardIRQHandler };
+    bool locked = DOS_LockIRQCode(kbd, handlers, SDL_arraysize(handlers));
+    locked = (DOS_LockVariable(keyevents_ringbuffer) == 0) && locked;
+    locked = (DOS_LockVariable(keyevents_head) == 0) && locked;
+    locked = (DOS_LockVariable(keyevents_tail) == 0) && locked;
+    if (!locked) {
+        SDL_Log("DOS: could not lock the keyboard interrupt handler's memory; no keyboard");
+        return;
+    }
 
     DOS_HookInterrupt(1, KeyboardIRQHandler, &data->keyboard_interrupt_hook);
 }
