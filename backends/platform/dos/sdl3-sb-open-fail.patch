SDL3 change the ScummVM DOS port needs so that a Sound Blaster it cannot
open leaves it running without digital sound: DOSSOUNDBLASTER_OpenDevice
stored device->hidden early, and an error return (no high DMA channel on an
SB16 whose BLASTER has no H, a failed DMA, ring or staging buffer
allocation, the interrupt memory lock) freed or leaked it without clearing
the pointer. The CloseDevice that SDL calls after a failed open then read
freed memory, wrote to the DSP and unhooked an interrupt that was never
hooked, and the program died with a CWSDPMI exception. OpenDevice now sets
device->hidden only once it cannot fail any more and frees its partial state
on every error path. The fixed build defines DOS_SBOpenFailChecked, which
build-dos.sh looks for and the port links against.

Base: sdl3-irq-code.patch, sdl3-cpuid.patch and sdl3-sb-shutdown.patch applied
(~/opt/src/SDL3 branch dos-sb-shutdown = dos-486 2df4ec6 + fbd0d18 + f6cc527).
Apply after those three (git apply skips this text):
  git -C SDL3 apply sdl3-irq-code.patch && git -C SDL3 apply sdl3-cpuid.patch \
    && git -C SDL3 apply sdl3-sb-shutdown.patch && git -C SDL3 apply sdl3-sb-open-fail.patch

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 98f9dc7..f6226eb 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -207,6 +207,49 @@ static bool DOSSOUNDBLASTER_WaitDevice(SDL_AudioDevice *device)
     }
 }
 
+/* Marks a build whose OpenDevice leaves device->hidden NULL when it fails: the
+   ScummVM DOS port refuses (and fails to link against) an SDL3 without it. */
+extern const int DOS_SBOpenFailChecked;
+const int DOS_SBOpenFailChecked = 1;
+
+// Release what OpenDevice set up before the interrupt was hooked, and the state itself.
+static void DOSSOUNDBLASTER_FreeState(struct SDL_PrivateAudioData *hidden)
+{
+    // disable DMA — mask the appropriate DMA channel.
+    if (hidden->dma_buffer) {
+        if (hidden->is_16bit) {
+            outportb(0xD4, 0x04 | hidden->dma_channel); // mask high DMA channel (channels 5-7)
+        } else {
+            outportb(0x0A, 0x04 | hidden->dma_channel); // mask low DMA channel (channels 0-3)
+        }
+        DOS_FreeConventionalMemory(&hidden->dma_seginfo);
+    }
+
+    // Free ring buffer resources.
+    SDL_free(hidden->ring_buffer);
+    SDL_free(hidden->staging_buffer);
+
+    // Clear ISR-visible statics.
+    isr_ring_buffer = NULL;
+    isr_ring_read = 0;
+    isr_ring_write = 0;
+    isr_ring_size = 0;
+    isr_ring_mask = 0;
+    isr_chunk_size = 0;
+    isr_dma_buffer = NULL;
+    isr_dma_halfdma = 0;
+    isr_irq_ack_port = 0;
+
+    SDL_free(hidden);
+}
+
+// OpenDevice failed: undo it, so that CloseDevice (which SDL still calls) has nothing left to do.
+static bool DOSSOUNDBLASTER_OpenFailed(struct SDL_PrivateAudioData *hidden)
+{
+    DOSSOUNDBLASTER_FreeState(hidden);
+    return false;
+}
+
 static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
 {
     const bool is_sb16 = soundblaster_is_sb16;
